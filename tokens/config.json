{
  "source": ["tokens/tokens.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "src/styles/",
      "files": [{
        "destination": "variables.css",
        "format": "css/variables"
      }]
    },
    "mui": {
      "transformGroup": "js",
      "buildPath": "src/styles/",
      "files": [{
        "destination": "tokens.js",
        "format": "javascript/module"
      }]
    }
  }
}